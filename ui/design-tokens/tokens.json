{
  "$comment": [
    "The Git Manager design system: one source for every platform. `bun run ui:tokens` writes CSS",
    "(Svelte), Swift (macOS), XAML (Windows) and GTK CSS (Linux) into generated/. Sizes are in points (px",
    "on the web)."
  ],
  "shadow": {
    "popup": {"light": "0 8px 28px rgba(0, 0, 0, 0.16)", "dark": "0 8px 28px rgba(0, 0, 0, 0.5)"},
    "segment": {"light": "0 1px 2px rgba(0, 0, 0, 0.14)", "dark": "0 1px 2px rgba(0, 0, 0, 0.14)"},
    "knob": {"light": "0 1px 2px rgba(0, 0, 0, 0.25)", "dark": "0 1px 2px rgba(0, 0, 0, 0.25)"}
  },
  "size": {
    "control": 28, "controlSmall": 24, "iconButtonSmall": 22, "rowItem": 20, "treeRow": 24, "statusBar": 24,
    "tabStrip": 34, "badge": 16, "tag": 16, "spinner": 12, "progress": 4, "icon": 16, "iconSmall": 12
  },
  "radius": {
    "small": 4, "segment": 5, "control": 6, "segmented": 7, "menu": 8, "dialog": 10, "window": 12, "round": 999
  },
  "space": {"1": 2, "2": 4, "3": 6, "4": 8, "5": 10, "6": 12, "7": 14, "8": 16, "9": 18, "10": 20, "11": 24},
  "motion": {"fast": 120, "normal": 150},
  "breakpoint": {
    "panelTiny": 220, "panelNarrow": 320, "panelCompact": 480, "panelMedium": 600, "windowCompact": 900,
    "windowRegular": 1200, "windowWide": 1600
  },
  "grid": {"columns": 12, "gutter": 16, "margin": 24, "maxWidth": 1200, "minColumn": 180}
}
