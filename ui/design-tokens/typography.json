{
  "$comment": [
    "Typography: font families, the size scale (px), weights, line heights (multiples of the size),",
    "letter spacing (em) and named text styles. A text style refers to the scales with {group.name}; omit",
    "lineHeight for the platform's normal line height. Text styles are what screens use, never raw sizes."
  ],
  "font": {
    "ui": ["-apple-system", "BlinkMacSystemFont", "Inter", "Segoe UI", "sans-serif"],
    "mono": ["JetBrains Mono", "Menlo", "Monaco", "Cascadia Mono", "Consolas", "Courier New", "monospace"]
  },
  "fontSize": {
    "micro": 9.5, "tiny": 10, "xsmall": 11, "compact": 11.5, "small": 12, "codeSmall": 12.5, "ui": 13, "code": 13,
    "title": 14, "heading": 15, "display": 22
  },
  "fontWeight": {"regular": 400, "medium": 500, "semibold": 600, "bold": 700},
  "lineHeight": {"dense": 1.25, "normal": 1.45, "relaxed": 1.5, "loose": 1.6},
  "letterSpacing": {"none": 0, "slight": 0.03, "label": 0.04, "caps": 0.06},
  "textStyle": {
    "body": {"font": "ui", "size": "{fontSize.ui}", "weight": "{fontWeight.regular}"},
    "bodyStrong": {"font": "ui", "size": "{fontSize.ui}", "weight": "{fontWeight.semibold}"},
    "label": {"font": "ui", "size": "{fontSize.ui}", "weight": "{fontWeight.medium}"},
    "hint": {
      "font": "ui", "size": "{fontSize.small}", "weight": "{fontWeight.regular}",
      "lineHeight": "{lineHeight.normal}", "tone": "dim"
    },
    "small": {"font": "ui", "size": "{fontSize.small}", "weight": "{fontWeight.regular}"},
    "caption": {"font": "ui", "size": "{fontSize.xsmall}", "weight": "{fontWeight.regular}", "tone": "dim"},
    "sectionLabel": {
      "font": "ui", "size": "{fontSize.xsmall}", "weight": "{fontWeight.semibold}",
      "letterSpacing": "{letterSpacing.label}", "uppercase": true, "tone": "faint"
    },
    "panelTab": {
      "font": "ui", "size": "{fontSize.xsmall}", "weight": "{fontWeight.semibold}",
      "letterSpacing": "{letterSpacing.caps}", "uppercase": true
    },
    "title": {"font": "ui", "size": "{fontSize.title}", "weight": "{fontWeight.semibold}"},
    "heading": {"font": "ui", "size": "{fontSize.heading}", "weight": "{fontWeight.semibold}"},
    "display": {"font": "ui", "size": "{fontSize.display}", "weight": "{fontWeight.semibold}"},
    "paragraph": {
      "font": "ui", "size": "{fontSize.ui}", "weight": "{fontWeight.regular}", "lineHeight": "{lineHeight.relaxed}"
    },
    "code": {"font": "mono", "size": "{fontSize.code}", "weight": "{fontWeight.regular}"},
    "codeSmall": {"font": "mono", "size": "{fontSize.codeSmall}", "weight": "{fontWeight.regular}"},
    "badge": {"font": "ui", "size": "{fontSize.tiny}", "weight": "{fontWeight.semibold}"}
  }
}
